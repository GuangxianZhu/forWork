KEYWORDS_BY_TAG = {
    "ONB2": [
        "step",
        "state",
        "start",
        "end",
        "send",
        "recv",
        "request",
        "wait",
        "timeout",
        "error",
        "alarm",
        "on",
        "off",
        "open",
        "close",
        "flow",
        "level",
        "sensor",
    ],
    "RS485DEVS4": [
        "send",
        "recv",
        "tx",
        "rx",
        "timeout",
        "retry",
        "error",
        "crc",
        "address",
        "response",
    ],
    "MachineAlarm": [
        "",   # 全部保留
    ],
}
def should_keep(tag, raw):
    keywords = KEYWORDS_BY_TAG.get(tag)
    if keywords is None:
        return False

    if "" in keywords:
        return True

    lower = raw.lower()
    return any(k in lower for k in keywords)

